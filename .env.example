DSS_VERSION=13.4.4
DSS_PORT=10000

# Digest of dataiku/dss:$DSS_VERSION, which pins the exact base image. Change it
# with DSS_VERSION; get it with: docker buildx imagetools inspect dataiku/dss:<version>
# Leave it empty (DSS_IMAGE_DIGEST=) to use the tag alone.
DSS_IMAGE_DIGEST=sha256:8bc5cd7512506a453e9ba9866786ff22937b3194dc70039539e5d04890b6a002

# JDBC drivers built into the image, from Maven Central. Leave a value empty
# (ORACLE_JDBC_VERSION=) to skip that driver. Rebuild after changing them.
ORACLE_JDBC_VERSION=21.24.0.0
TRINO_JDBC_VERSION=484

# Upgrading an existing data directory to a newer DSS_VERSION cannot be undone,
# so it is refused unless this is set to that new version. The data directory
# is then backed up to ./backups before the upgrade.
DSS_ALLOW_UPGRADE=
